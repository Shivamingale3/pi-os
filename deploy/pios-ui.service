# PiOS screen: Home on the 480x320 panel, touch, backlight.
# Installed by `pios setup` but NOT enabled: start it to take over the panel from tft-btop
# (Conflicts= stops tft-btop); start tft-btop to get the old session back. A reboot brings
# back whatever is enabled at boot.
[Unit]
Description=PiOS screen (480x320 panel)
Conflicts=tft-btop.service
Wants=pios-agent.service
After=pios-agent.service tft-btop.service

[Service]
Type=simple
User=pios-ui
Group=pios-ui
# video: /dev/fb0 · input: the touch device · pios: the agent's API socket
SupplementaryGroups=video input pios
Environment=PIOS_SOCKET=/run/pios/pios.sock
Environment=PIOS_BACKLIGHT=/sys/class/backlight/tft-backlight/brightness
Environment=PIOS_IDLE_MIN=30
Environment="PIOS_TOUCH_MATRIX=0 1.1052 -0.0649 1.1297 0 -0.0755"
# '+' = these two run as root, outside the sandbox: hide the text console on the panel and let
# pios-ui switch the backlight; on stop, give both back (the console reappears on the panel).
ExecStartPre=+/bin/sh -c 'for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" "$v/name" && echo 0 > "$v/bind"; done; b=/sys/class/backlight/tft-backlight/brightness; if [ -e "$b" ]; then chgrp pios-ui "$b"; chmod g+w "$b"; echo 1 > "$b"; fi; true'
ExecStart=/usr/local/bin/pios ui --fb /dev/fb0 --touch /dev/input/by-path/platform-1f00054000.spi-cs-0-event
ExecStopPost=+/bin/sh -c 'b=/sys/class/backlight/tft-backlight/brightness; if [ -e "$b" ]; then echo 1 > "$b"; chgrp root "$b"; chmod g-w "$b"; fi; for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" "$v/name" && echo 1 > "$v/bind"; done; true'
Restart=on-failure
RestartSec=5

Nice=5
CPUQuota=10%
MemoryMax=60M
TasksMax=8

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=/dev/fb0 rw
DeviceAllow=char-input r
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ProtectProc=invisible
IPAddressDeny=any
RemoveIPC=yes
KeyringMode=private
