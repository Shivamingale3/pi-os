# Root, started by pios-helper.socket. Forwards an allow-list of Docker requests (see
# helper.rs) and edits fan_ctl's manual override; refuses everything else.
[Unit]
Description=PiOS helper (filtered Docker access)
Requires=pios-helper.socket
# /run/fan_ctl must exist when the helper starts, for the ReadWritePaths= below
After=fan_ctl.service

[Service]
Type=simple
ExecStart=/usr/local/bin/pios helper
Environment=PIOS_DOCKER_SOCKET=/var/run/docker.sock

Nice=10
CPUQuota=5%
MemoryMax=16M
TasksMax=4

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# the only path it writes: fan_ctl's override (fan_ctl ≥ 0.2 keeps the directory; "-": optional)
ReadWritePaths=-/run/fan_ctl
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
IPAddressDeny=any
PrivateUsers=no
RemoveIPC=yes
KeyringMode=private
