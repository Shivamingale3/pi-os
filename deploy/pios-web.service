# PiOS web checks and phone alerts: fetches the public hostnames in /etc/pios/checks every 60 s
# (one curl --parallel, results in /run/pios-web/web.json for the agent), and every 15 s sends
# the agent's due alerts to Telegram (the bot token: /etc/pios/telegram, as a credential).
# Installed by `pios setup`. The only PiOS process with network access: its own throwaway user
# (DynamicUser), read-only system, no privileges, capped.
[Unit]
Description=PiOS web checks (public hostnames)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/pios web
Environment=PIOS_CHECKS=/etc/pios/checks
Environment=PIOS_WEB_OUT=/run/pios-web/web.json
# the agent's API (what alerts are due): group pios opens its socket
Environment=PIOS_SOCKET=/run/pios/pios.sock
SupplementaryGroups=pios
# the bot token, handed over by systemd (this throwaway user can't read /etc/pios/telegram itself)
LoadCredential=telegram:/etc/pios/telegram
# the alerts' cursor and the learned chat ID
StateDirectory=pios-web
Restart=on-failure
RestartSec=10

# the results file: readable by the agent, nothing secret in it
RuntimeDirectory=pios-web
RuntimeDirectoryMode=0755
UMask=0022

# Resources: low priority, hard caps (curl runs about a second a minute).
Nice=10
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=48M
TasksMax=32

# Sandbox: network yes (that's its job), everything else no.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RemoveIPC=yes
KeyringMode=private

[Install]
WantedBy=multi-user.target
