{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-restricted-globals": [
      "error",
      {
        "name": "Number",
        "message": "Use parseNum() from src/parse.ts (Go: strconv.ParseFloat)."
      },
      {
        "name": "parseFloat",
        "message": "Use parseNum() from src/parse.ts (Go: strconv.ParseFloat)."
      },
      {
        "name": "parseInt",
        "message": "Use parseNum() from src/parse.ts (Go: strconv.ParseFloat)."
      },
      {
        "name": "isNaN",
        "message": "Use parseNum() from src/parse.ts (Go: strconv.ParseFloat)."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/parse.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ]
}
